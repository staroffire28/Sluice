<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    [Inject]
    private Sluice.Portal.Services.Logging.CircuitAuditActor AuditActor { get; set; } = default!;

    // Cliente (IP y hash de la sesión) que App.razor calculó en el render estático.
    [Parameter]
    public string? AuditClient { get; set; }

    [Inject]
    private Sluice.Portal.Services.Auth.CircuitSessionGuard SessionGuard { get; set; } = default!;

    // Token de la cookie de sesión con el que se abrió el circuito (ver CircuitSessionGuard).
    [Parameter]
    public string? SessionToken { get; set; }

    protected override void OnInitialized()
    {
        AuditActor.Set(AuditClient);
        SessionGuard.Capture(SessionToken);
    }
}
