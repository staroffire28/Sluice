@* Texto que solo se parte tras el separador ('/' en rutas): el navegador corta también tras '-'
   y dejaba "pipe-" en una línea y "demo/…" en la siguiente. Cada tramo va en un span sin
   saltos (.cell-path) y el <wbr> marca el único punto de corte permitido. *@
<span class="cell-path">@for (var i = 0; i < _segments.Count; i++)
{
    if (i > 0)
    {
        <wbr />
    }
    <span>@_segments[i]</span>
}</span>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public char Separator { get; set; } = '/';

    private List<string> _segments = [];

    // El separador se queda al final de su tramo: "pipe-demo/" y "custtable.parquet".
    protected override void OnParametersSet()
    {
        var parts = Value.Split(Separator);
        _segments = parts.Select((s, i) => i < parts.Length - 1 ? s + Separator : s).ToList();
    }
}
