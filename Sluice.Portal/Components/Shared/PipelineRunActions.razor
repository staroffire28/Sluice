@using Sluice.Portal.Models
@using Sluice.Portal.Services
@using Sluice.Portal.Services.Logging
@inject IOrchestrationService Orchestration
@inject INotificationService NotificationService
@inject IDialogService DialogService
@inject CircuitAuditActor Audit
@inject IStringLocalizer<SharedResource> L

<FluentMenuItem data-testid="@($"run-{PipelineId}")" Disabled="@string.IsNullOrWhiteSpace(PipelineId)" OnClick="@(() => RunAsync(JobType.Incremental))">@L["Common.Run"]</FluentMenuItem>
<FluentMenuItem data-testid="@($"force-{PipelineId}")" Disabled="@string.IsNullOrWhiteSpace(PipelineId)" OnClick="@(() => RunAsync(JobType.Force))">@L["Page.Pipelines.Force"]</FluentMenuItem>
<FluentMenuItem data-testid="@($"reconcile-{PipelineId}")" Disabled="@string.IsNullOrWhiteSpace(PipelineId)" OnClick="@(() => RunAsync(JobType.Reconcile))">@L["Page.Pipelines.Reconcile"]</FluentMenuItem>
<FluentMenuItem data-testid="@($"diff-{PipelineId}")" Disabled="@string.IsNullOrWhiteSpace(PipelineId)" OnClick="@(() => RunAsync(JobType.Diff))">@L["Page.Pipelines.Diff"]</FluentMenuItem>

@code {
    [Parameter, EditorRequired]
    public string PipelineId { get; set; } = "";

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    private async Task RunAsync(JobType type)
    {
        // Con el pipeline ocupado, en vez de rechazarlo se ofrece dejarlo en cola.
        if (await Orchestration.IsBusyAsync(PipelineId))
        {
            await QueueAsync(type);
            return;
        }

        if (!await ConfirmRunAsync(type))
        {
            return;
        }

        try
        {
            var job = await Orchestration.RunPipelineAsync(Audit.Current, PipelineId, type);
            await NotificationService.ShowSuccessToastAsync(string.Format(L["Page.Pipelines.JobStarted"].Value, job.Id, JobTypeLabels.Get(L, type)));
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await NotificationService.ShowErrorToastAsync(ErrorText.Render(L, ex));
        }
    }

    // El scheduler la lanza en su siguiente vuelta tras quedar libre el pipeline.
    private async Task QueueAsync(JobType type)
    {
        var label = JobTypeLabels.Get(L, type);
        var message = string.Format(L["Page.Pipelines.QueueConfirm"].Value, label);
        if (type == JobType.Force)
        {
            message += " " + L["Page.Pipelines.QueueForceNote"].Value;
        }

        var result = await DialogService.ShowConfirmationAsync(
            message,
            L["Page.Pipelines.QueueConfirmTitle"].Value,
            L["Page.Pipelines.QueueAction"].Value,
            L["Common.Cancel"].Value);
        if (result.Cancelled)
        {
            return;
        }

        try
        {
            Orchestration.QueueRun(Audit.Current, PipelineId, type);
            await NotificationService.ShowSuccessToastAsync(string.Format(L["Page.Pipelines.Queued"].Value, label));
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await NotificationService.ShowErrorToastAsync(ErrorText.Render(L, ex));
        }
    }

    private async Task<bool> ConfirmRunAsync(JobType type)
    {
        var message = type == JobType.Force
            ? L["Page.Dashboard.ForceConfirm"].Value
            : string.Format(L["Page.Dashboard.RunConfirm"].Value, JobTypeLabels.Get(L, type));
        var result = await DialogService.ShowConfirmationAsync(
            message,
            L["Page.Dashboard.RunConfirmTitle"].Value,
            L["Common.Run"].Value,
            L["Common.Cancel"].Value);
        return !result.Cancelled;
    }
}