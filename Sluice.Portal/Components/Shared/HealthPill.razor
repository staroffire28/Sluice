@rendermode InteractiveServer
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Hosting.Server
@using Microsoft.AspNetCore.Hosting.Server.Features
@inject IHttpClientFactory HttpFactory
@inject IServer Server
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<FluentBadge Appearance="@_appearance" Color="@_color" id="health-pill" title="@_title">@_label</FluentBadge>

@code {
    private string _label = "";
    private string? _title;
    private BadgeAppearance _appearance = BadgeAppearance.Tint;
    private BadgeColor _color = BadgeColor.Informative;
    private PageRefreshTimer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _label = L["Common.Health.Checking"];
        await RefreshAsync(CancellationToken.None);
        // Timer común de las páginas (ciclo de vida y disposición ya resueltos ahí).
        _timer = new PageRefreshTimer(TimeSpan.FromSeconds(60), RefreshAsync);
        _timer.Start();
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        try
        {
            var client = HttpFactory.CreateClient();
            client.BaseAddress = ResolveSelfBaseAddress();
            using var response = await client.GetAsync("/health", ct);
            // Una respuesta no correcta (DATA_DIR no escribible) sigue siendo "Degradado" sin motivo.
            IReadOnlyList<string>? reasons = response.IsSuccessStatusCode
                ? DegradedReasons(await response.Content.ReadAsStringAsync(ct))
                : [];
            _title = reasons is { Count: > 0 } ? string.Join("; ", reasons.Select(r => L[r].Value)) : null;
            if (reasons is null)
            {
                _label = L["Common.Health.Online"];
                _appearance = BadgeAppearance.Tint;
                _color = BadgeColor.Informative;
            }
            else
            {
                _label = L["Common.Health.Degraded"];
                // Relleno de aviso: Filled+Brand era del mismo azul que la cabecera (1:1) y Tint+Warning
                // se funde con ella en oscuro (1,5:1); este queda a 4,1:1 y 5,1:1, texto a 11,9:1.
                _appearance = BadgeAppearance.Filled;
                _color = BadgeColor.Warning;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Componente desmontado: no hay nada que pintar (antes se marcaba "Offline" y se
            // llamaba a StateHasChanged sobre un componente ya desechado).
            return;
        }
        catch
        {
            _title = null;
            _label = L["Common.Health.Offline"];
            // Tinte de error: Ghost+Informative era un gris neutro casi igual que "En línea". Texto a
            // 5,5:1 (claro) y 5,8:1 (oscuro); contra la cabecera, 5,0:1 y 2,4:1 (lo distingue el tono).
            _appearance = BadgeAppearance.Tint;
            _color = BadgeColor.Danger;
        }

        await InvokeAsync(StateHasChanged);
    }

    // Motivos (claves de recurso) de un /health que responde 200 con status "degraded" (scheduler
    // parado, poco disco); null si no está degradado o el cuerpo no se entiende (se trata como antes).
    internal static IReadOnlyList<string>? DegradedReasons(string body)
    {
        try
        {
            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind != JsonValueKind.Object || Field(root, "status") != "degraded")
            {
                return null;
            }

            var reasons = new List<string>();
            if (Field(root, "scheduler") == "stale")
            {
                reasons.Add("Common.Health.Reason.SchedulerStale");
            }

            if (Field(root, "disk") == "low")
            {
                reasons.Add("Common.Health.Reason.DiskLow");
            }

            if (Field(root, "config") == "unreadable")
            {
                reasons.Add("Common.Health.Reason.ConfigUnreadable");
            }

            return reasons;
        }
        catch (JsonException)
        {
            return null;
        }

        static string? Field(JsonElement root, string name) =>
            root.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;
    }

    // El portal se comprueba a sí mismo por loopback usando el puerto real de
    // Kestrel. Es fiable en cualquier entorno (container, local, tras un proxy),
    // a diferencia de Navigation.BaseUri (URL pública, no enrutable desde dentro
    // del propio proceso/container).
    private Uri ResolveSelfBaseAddress()
    {
        var address = Server.Features.Get<IServerAddressesFeature>()?.Addresses
            .FirstOrDefault();
        if (address is not null && Uri.TryCreate(address, UriKind.Absolute, out var uri))
        {
            return new Uri($"{uri.Scheme}://localhost:{uri.Port}");
        }

        return new Uri(Navigation.BaseUri);
    }

    public async ValueTask DisposeAsync()
    {
        if (_timer is not null)
        {
            await _timer.DisposeAsync();
        }
    }
}