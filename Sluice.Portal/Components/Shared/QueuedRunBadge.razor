@using Sluice.Portal.Services
@using Sluice.Portal.Services.Logging
@using Sluice.Portal.Services.Stores
@inject IOrchestrationService Orchestration
@inject INotificationService NotificationService
@inject CircuitAuditActor Audit
@inject IStringLocalizer<SharedResource> L

@* La ejecución que espera a que termine el job en curso, con la opción de quitarla. *@
@if (Queued is { } queued)
{
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" VerticalAlignment="VerticalAlignment.Center" Width="auto" data-testid="@($"queued-{PipelineId}")">
        <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning" Style="white-space:nowrap;">@L["Page.Pipelines.QueuedBadge", JobTypeLabels.Get(L, queued.Type)]</FluentBadge>
        <FluentButton Appearance="ButtonAppearance.Subtle" Style="white-space:nowrap;" data-testid="@($"unqueue-{PipelineId}")" OnClick="RemoveAsync">@L["Page.Pipelines.Unqueue"]</FluentButton>
    </FluentStack>
}
@* Resultado de quitar de la cola: región viva y destino del foco, porque el botón desaparece con
   la etiqueta y el foco se perdía. *@
<span role="status" tabindex="-1" class="field-hint" data-testid="@($"unqueue-status-{PipelineId}")" @ref="_status">@_result</span>

@code {
    [Parameter, EditorRequired]
    public string PipelineId { get; set; } = "";

    // Lo lee la página en cada render: con solo el id (un string que no cambia) Blazor no volvería a
    // pintar el componente al encolar o al arrancar lo encolado.
    [Parameter]
    public QueuedRun? Queued { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ElementReference _status;
    private string? _result;
    private bool _focusStatus;
    private string? _resultPipelineId;

    // Un nuevo encolado borra el resultado del anterior, y también otro pipeline: el Dashboard y las
    // filas de la tabla reutilizan la misma instancia.
    protected override void OnParametersSet()
    {
        if (Queued is not null || PipelineId != _resultPipelineId)
        {
            _result = null;
        }
        _resultPipelineId = PipelineId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusStatus)
        {
            _focusStatus = false;
            await _status.FocusAsync();
        }
    }

    private async Task RemoveAsync()
    {
        if (Queued is not { } queued)
        {
            return;
        }

        // Si el scheduler ya lo reservó para lanzarlo, no se puede quitar: se avisa y se refresca.
        var label = JobTypeLabels.Get(L, queued.Type);
        if (Orchestration.DequeueRun(Audit.Current, PipelineId) is not null)
        {
            _result = string.Format(L["Page.Pipelines.Unqueued"].Value, label);
            await NotificationService.ShowSuccessToastAsync(_result);
        }
        else
        {
            _result = string.Format(L["Page.Pipelines.QueueAlreadyStarted"].Value, label);
            await NotificationService.ShowInfoToastAsync(_result);
        }

        _focusStatus = true;
        await OnChanged.InvokeAsync();
    }
}
