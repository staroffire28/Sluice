@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L

@* La landing (Login.razor) ocupa toda la ventana: sin cabecera; el idioma y el tema van en la
   propia página. *@
@Body

<FluentProviders />

@* blazor.web.js la muestra y engancha los clics de .reload y .dismiss. role="alert" la anuncia al
   aparecer; botones (no enlaces sin href) para que se alcancen con el teclado. *@
<div id="blazor-error-ui" role="alert">
    @L["ErrorUi.Message"]
    <button type="button" class="reload">@L["ErrorUi.Reload"]</button>
    <button type="button" class="dismiss" aria-label="@L["Common.Close"]">🗙</button>
</div>
