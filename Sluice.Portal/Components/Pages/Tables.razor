@page "/tables"
@rendermode InteractiveServer
@using Sluice.Portal.Components.Shared
@using Sluice.Portal.Models
@using Sluice.Portal.Services
@using Sluice.Portal.Services.Stores
@using Sluice.Portal.Services.Logging
@inject IPipelineService PipelineService
@inject ReportStore Reports
@inject TablePauseStore PauseStore
@inject SettingsStore Settings
@inject INotificationService NotificationService
@inject Sluice.Portal.Services.Pipeline.TableCatalogService CatalogService
@inject CircuitAuditActor Audit
@inject NavigationManager Nav
@inject BrowserTime Time

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav.Tables"]</PageTitle>

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="12">
    <PageHeader Title="@L["Page.Tables.Title"]" Subtitle="@L["Page.Tables.Subtitle"]" />

    <PageSection Class="section-panel--dropdown">
    <div class="toolbar">
    <FluentSelect TOption="string" TValue="string" @bind-Value="_pipelineId" @bind-Value:after="Load" data-testid="tables-pipeline" Label="@L["Common.Pipeline"]" Style="min-width:240px;">
        @foreach (var p in PipelineService.List())
        {
            <FluentOption TValue="string" Value="@p.Id">@p.Name</FluentOption>
        }
    </FluentSelect>

    <FluentTextInput @bind-Value="_search" @bind-Value:after="Load" data-testid="tables-search" Label="@L["Common.Search"]" Placeholder="@L["Page.Tables.FilterPlaceholder"]" Style="min-width:220px;" />
    </div>
    </PageSection>

    <PageSection>
    <PanelState IsEmpty="@(string.IsNullOrWhiteSpace(_pipelineId))" EmptyText="@L["Page.Tables.SelectPipeline"]">
        <PanelState IsEmpty="@(_allRows.Count == 0)" EmptyText="@L["Page.Tables.NoTables"]">
            <FluentDataGrid Class="data-panel" MultiLine="true"
                            GridTemplateColumns="minmax(max-content, 1.6fr) 0.8fr 1.4fr 1.2fr 0.9fr 0.8fr 1fr max-content"
                            Items="@_rows.AsQueryable()" TGridItem="TableRow">
                <PropertyColumn Property="@(r => r.Entity)" Title="@L["Common.Entity"]" Class="cell-nowrap" />
                <PropertyColumn Property="@(r => r.RowCount)" Title="@L["Common.Rows"]" Class="cell-nowrap" />
                <PropertyColumn Property="@(r => r.Watermark.HasValue ? Time.Format(r.Watermark.Value) : "-")" Title="@L["Page.Tables.Watermark"]" Class="cell-nowrap" />
                <TemplateColumn Title="@L["Page.Tables.LastData"]" Class="cell-nowrap">
                    @if (context.LastLoad is { } lastLoad)
                    {
                        var days = (int)(DateTimeOffset.UtcNow - lastLoad).TotalDays;
                        var stale = _staleTableDays > 0 && days >= _staleTableDays;
                        <span class="@(stale ? "table-stale" : null)" data-testid="last-data-@context.Entity" data-stale="@(stale ? "true" : "false")"
                              title="@(stale ? L["Page.Tables.LastDataStale", days].Value : null)">@Time.Format(lastLoad)</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@L["Page.Tables.Divergence"]">
                    @if (context.DivergencePct is { } pct)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" VerticalAlignment="VerticalAlignment.Center">
                            <FluentBadge Appearance="@(pct > 0 ? BadgeAppearance.Filled : BadgeAppearance.Tint)" Color="@(pct > 0 ? BadgeColor.Brand : BadgeColor.Informative)">@pct.ToString("F2")%</FluentBadge>
                            @if (context.ReportIsPartial)
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size16.Warning())"
                                            Color="Color.Warning"
                                            Title="@L["Page.Tables.DivergenceAboveThreshold"]" />
                            }
                        </FluentStack>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Status"]">
                    <StatusBadge Status="@context.Status" />
                </TemplateColumn>
                <TemplateColumn Title="@L["Page.Tables.Sync"]">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentSwitch TValue="bool" data-testid="@($"sync-{context.Entity}")" Value="@(!context.Paused)"
                                      AriaLabel="@L["Page.Tables.SyncAria", context.Entity]"
                                      ValueChanged="@(active => TogglePaused(context.Entity, !active))" />
                        @if (context.Paused)
                        {
                            <FluentBadge data-testid="@($"paused-{context.Entity}")" Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative">@L["Page.Tables.Paused"]</FluentBadge>
                        }
                    </FluentStack>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Actions"]">
                    @* Menú de tres puntos: los dos botones no cabían en la columna y se apilaban.
                       Re-sincronizar cualquier tabla, no solo las que divergen en Conciliación: una
                       tabla con el mismo número de filas puede tener filas desactualizadas. *@
                    <FluentMenu>
                        <FluentButton slot="@FluentSlot.Trigger" Appearance="ButtonAppearance.Subtle" IconOnly="true"
                                      IconStart="@(new Icons.Regular.Size20.MoreHorizontal())"
                                      Title="@L["Common.Actions"]" aria-label="@($"{L["Common.Actions"]} {context.Entity}")"
                                      data-testid="@($"table-actions-{context.Entity}")" />
                        <FluentMenuList>
                            <ResyncTableButton PipelineId="@_pipelineId" Entity="@context.Entity" TestId="@($"resync-{context.Entity}")" />
                            <FluentMenuItem data-testid="@($"analytics-{context.Entity}")" IconStart="@(new Icons.Regular.Size20.DataTrending())"
                                            OnClick="@(() => Nav.NavigateTo($"/tables/{Uri.EscapeDataString(_pipelineId)}/{Uri.EscapeDataString(context.Entity)}/analytics"))">
                                @L["Page.Tables.Analytics"]
                            </FluentMenuItem>
                        </FluentMenuList>
                    </FluentMenu>
                </TemplateColumn>
            </FluentDataGrid>
            <PaginationControl Page="_page" TotalPages="_totalPages" TotalCount="_totalCount" PageChanged="OnPageChanged" />
        </PanelState>
    </PanelState>
    </PageSection>
</FluentStack>

@code {
    private string _pipelineId = "";
    private string _search = "";
    private List<TableRow> _allRows = [];
    private List<TableRow> _rows = [];
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private int _totalPages = 1;

    protected override void OnInitialized()
    {
        var first = PipelineService.List().FirstOrDefault();
        if (first is not null)
        {
            _pipelineId = first.Id;
            Load();
        }
    }

    // Las fechas van en la zona del navegador, que solo se conoce con el circuito conectado.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await Time.InitAsync())
        {
            StateHasChanged();
        }
    }

    private void Load()

    {
        if (string.IsNullOrWhiteSpace(_pipelineId))
        {
            _allRows = [];
            ApplyPaging();
            return;
        }

        var state = PipelineService.GetState(_pipelineId);
        // Divergencia desde el último reporte de conciliación (fuente única de verdad);
        // se cruza por entidad para mostrarla junto al estado de carga. IsPartial (a nivel
        // de reporte) indica que la divergencia máxima supera el umbral configurado — se
        // repite en cada fila para poder marcar visualmente el warning junto al %.
        var latestReport = Reports.GetLatestReconcile(_pipelineId);
        var divergence = latestReport?.Entities
            .ToDictionary(e => e.Entity, e => e.DivergencePct, StringComparer.OrdinalIgnoreCase)
            ?? new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        var reportIsPartial = latestReport?.IsPartial ?? false;
        var paused = PauseStore.GetPaused(_pipelineId);
        _staleTableDays = Settings.Get().StaleTableDays;

        _allRows = state.Tables
            .Where(kv => string.IsNullOrWhiteSpace(_search)
                || kv.Key.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .Select(kv => new TableRow
            {
                Entity = kv.Key,
                RowCount = kv.Value.RowCount,
                Watermark = kv.Value.Watermark,
                LastLoad = kv.Value.LastLoad,
                Status = kv.Value.Status,
                DivergencePct = divergence.TryGetValue(kv.Key, out var pct) ? pct : null,
                ReportIsPartial = reportIsPartial,
                Paused = paused.Contains(kv.Key),
            })
            .OrderBy(r => r.Entity, StringComparer.OrdinalIgnoreCase)
            .ToList();

        ApplyPaging();
    }

    // Los stores subyacentes ya cargan todo en memoria (JsonFileStore.ListAll lee cada
    // archivo); paginar aquí es solo de presentación, sin tocar los servicios.
    private void ApplyPaging()
    {
        _totalCount = _allRows.Count;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
        if (_page > _totalPages)
        {
            _page = _totalPages;
        }

        _rows = _allRows.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void OnPageChanged(int page)
    {
        _page = page;
        ApplyPaging();
    }

    // Pausar/reanudar la sincronización de una tabla. Pausada = se omite en próximas corridas
    // del pipeline (no se ingesta ni se mergea); su estado/datos ya sincronizados se conservan.
    private void TogglePaused(string entity, bool paused)
    {
        CatalogService.SetTableIncluded(Audit.Current, _pipelineId, entity, included: !paused);
        var key = paused ? "Page.Tables.PausedToast" : "Page.Tables.ResumedToast";
        _ = NotificationService.ShowInfoToastAsync(string.Format(L[key].Value, entity));
        Load();
    }

    private int _staleTableDays;

    private sealed class TableRow
    {
        public string Entity { get; init; } = "";
        public long RowCount { get; init; }
        public DateTimeOffset? Watermark { get; init; }
        public DateTimeOffset? LastLoad { get; init; }
        public string Status { get; init; } = "ok";
        public double? DivergencePct { get; init; }
        public bool ReportIsPartial { get; init; }
        public bool Paused { get; init; }
    }
}