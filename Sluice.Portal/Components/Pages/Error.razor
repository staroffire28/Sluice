@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> L

@* Destino de UseExceptionHandler: sin detalles del error (podrían ser sensibles), solo el id de la
   petición para buscarla en los logs. *@
<PageTitle>@L["ErrorPage.Title"]</PageTitle>

<PageHeader Title="@L["ErrorPage.Title"]" />

<p role="alert">@L["ErrorPage.Message"]</p>

@if (ShowRequestId)
{
    <p>
        @L["ErrorPage.RequestId"] <code>@RequestId</code>
    </p>
}

<p><a href="">@L["ErrorPage.Home"]</a></p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
