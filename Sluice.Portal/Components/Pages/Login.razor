@page "/login"
@layout LoginLayout
@using Microsoft.Extensions.Options
@using Sluice.Portal.Configuration
@using Sluice.Portal.Services.Auth
@inject IStringLocalizer<SharedResource> L
@inject IAuthService Auth
@inject IOptions<AppOptions> Options

<PageTitle>@(Auth.IsUiAuthEnabled ? L["Login.PageTitle"] : L["App.Title"])</PageTitle>

@* Landing con panel dividido: a la izquierda qué es el portal; a la derecha el acceso. Con clave,
   el formulario (POST /auth/login); sin clave (AUTH_MODE=none, o Development sin UI_API_KEY),
   "Entrar" lleva al portal por /auth/enter. *@
<div class="landing">
    <section class="landing__hero">
        <div class="landing__brand">
            <img src="logo.svg" alt="" width="40" height="40" />
            <span>@L["App.Title"]</span>
        </div>
        <div class="landing__pitch">
            <h1>@L["Login.Hero.Title"]</h1>
            <p>@L["Login.Hero.Text"]</p>
        </div>
        <p class="landing__meta">@(Options.Value.IsDistributed ? L["Login.Mode.Distributed"] : L["Login.Mode.Local"])</p>
    </section>

    <section class="landing__panel">
        @* Sin sesión la landing no tiene circuito de Blazor: LanguageToggle/ThemeToggle (OnClick)
           no harían nada. El idioma es un enlace a /culture/set y el tema lo atiende app-ui.js
           ([data-theme-toggle]) con el mismo ajuste de Fluent en localStorage. *@
        <div class="landing__toolbar">
            <a class="landing__tool"
               href="@LanguageHref"
               title="@($"{L["Lang.Change"]} ({_nextCulture.ToUpperInvariant()})")"
               aria-label="@L["Lang.Change"]"
               data-testid="lang-toggle">
                <FluentIcon Value="@(new Icons.Regular.Size20.Translate())" />
            </a>
            <button type="button"
                    class="landing__tool"
                    data-theme-toggle
                    data-label-dark="@L["Theme.SwitchToDark"]"
                    data-label-light="@L["Theme.SwitchToLight"]"
                    title="@L["Theme.SwitchToDark"]"
                    aria-label="@L["Theme.SwitchToDark"]"
                    data-testid="theme-toggle">
                <span class="landing__icon-moon"><FluentIcon Value="@(new Icons.Filled.Size20.WeatherMoon())" /></span>
                <span class="landing__icon-sun"><FluentIcon Value="@(new Icons.Filled.Size20.WeatherSunny())" /></span>
            </button>
        </div>

        <div class="landing__card">
            @if (!Auth.IsUiAuthEnabled)
            {
                <div class="landing__heading">
                    <h2>@L["Login.Open.Heading"]</h2>
                    <p>@L["Login.Open.Text"]</p>
                </div>
                <a class="landing__button" href="/auth/enter" data-testid="landing-enter">@L["Login.Open.Enter"]</a>
                <p class="landing__warning" role="note" data-testid="landing-open-warning">
                    <svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><path d="M9 2 1.5 15.5h15L9 2z" /><path d="M9 7.5v3.5M9 13v.5" /></svg>
                    <span>@L["Login.Open.Warning"]</span>
                </p>
            }
            else
            {
                <div class="landing__heading">
                    <h2>@L["Login.Heading"]</h2>
                    <p>@L["Login.Subtitle"]</p>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">@_errorMessage</FluentMessageBar>
                }

                <form method="post" action="/auth/login" class="landing__form" data-testid="login-form">
                    <AntiforgeryToken />
                    <label for="api-key">@L["Login.ApiKeyLabel"]</label>
                    <div class="landing__key">
                        <input id="api-key"
                               type="password"
                               name="key"
                               autocomplete="current-password"
                               data-testid="login-api-key"
                               required />
                        @* Sin sesión no hay circuito: lo atiende app-ui.js ([data-toggle-key]). *@
                        <button type="button"
                                class="landing__eye"
                                data-toggle-key="api-key"
                                data-label-show="@L["Login.ShowKey"]"
                                data-label-hide="@L["Login.HideKey"]"
                                aria-label="@L["Login.ShowKey"]"
                                aria-pressed="false"
                                title="@L["Login.ShowKey"]"
                                data-testid="login-show-key">
                            <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path d="M1.5 9S4.5 3.5 9 3.5 16.5 9 16.5 9 13.5 14.5 9 14.5 1.5 9 1.5 9z" /><circle cx="9" cy="9" r="2.4" /></svg>
                        </button>
                    </div>
                    <button type="submit" class="landing__button" data-testid="login-submit">@L["Login.SignIn"]</button>
                </form>
                <p class="landing__help">@L["Login.Help"]</p>
            }
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? _errorMessage;
    private string _nextCulture = "en";

    // Recarga completa: fija la cookie de cultura y vuelve a la landing (ver CultureEndpoints).
    private string LanguageHref => $"/culture/set?culture={_nextCulture}&redirectUri=%2Flogin";

    protected override void OnInitialized()
    {
        _nextCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "es" : "en";

        _errorMessage = Error switch
        {
            "invalid" => L["Login.Error.Invalid"].Value,
            "required" => L["Login.Error.Required"].Value,
            "csrf" => L["Login.Error.Csrf"].Value,
            "throttled" => L["Login.Error.Throttled"].Value,
            _ => null,
        };
    }
}
