@page "/pipelines"
@rendermode InteractiveServer
@using Sluice.Portal.Components.Shared
@using Sluice.Portal.Models
@using Sluice.Portal.Services
@using Sluice.Portal.Services.Stores
@using Sluice.Portal.Services.Logging
@using Sluice.Portal.Services.Pipeline
@inject IPipelineService PipelineService
@inject IPipelineResetService PipelineResetService
@inject IConnectionService Connections
@inject ReportStore Reports
@inject INotificationService NotificationService
@inject IDialogService DialogService
@inject CircuitAuditActor Audit
@inject RunQueueService RunQueue
@inject NavigationManager Nav
@inject ILogger<Pipelines> Logger
@implements IAsyncDisposable

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav.Pipelines"]</PageTitle>

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="12">
    <PageHeader Title="@L["Page.Pipelines.Title"]" Subtitle="@L["Page.Pipelines.Subtitle"]">
        <Actions>
            <FluentButton Appearance="ButtonAppearance.Primary" data-testid="add-pipeline" OnClick="OpenCreate">@L["Common.Add"]</FluentButton>
        </Actions>
    </PageHeader>

    @* Aviso de página: arriba, bajo la cabecera, como en Conciliación y Snapshots. *@
    @if (_latestReconcile is not null)
    {
        <FluentMessageBar data-testid="pipe-latest-reconcile" Intent="@(_latestReconcile.IsPartial ? MessageBarIntent.Warning : MessageBarIntent.Success)">
            @L["Page.Pipelines.LatestReconcile"] @_latestReconcile.MaxDivergencePct.ToString("F2")% (@_latestReconcile.Entities.Count @L["Page.Pipelines.Entities"])
        </FluentMessageBar>
    }

    @* Recién creado: antes de la primera ejecución conviene elegir qué tablas cargar. *@
    @if (_createdPipelineId is { } createdId)
    {
        <FluentMessageBar Intent="MessageBarIntent.Info" data-testid="pipe-created-catalog">
            @L["Page.Pipelines.ChooseTables"]
            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="pipe-created-catalog-open"
                          OnClick="@(() => Nav.NavigateTo($"/catalog?pipeline={Uri.EscapeDataString(createdId)}"))">@L["Page.Pipelines.ChooseTablesAction"]</FluentButton>
        </FluentMessageBar>
    }

    <PageSection>
    <ListWithEmptyCta HasItems="@(_allItems.Count > 0)" EmptyText="@L["Page.Pipelines.EmptyText"]">
        <EmptyAction>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="OpenCreate">@L["Common.Add"]</FluentButton>
        </EmptyAction>
        <ListContent>
            <FluentDataGrid Class="data-panel" MultiLine="true" Items="@_items.AsQueryable()" TGridItem="Pipeline">
                <PropertyColumn Property="@(p => p.Name)" Title="@L["Common.Name"]" />
                @* El nombre de la conexión; el id queda en el tooltip y en el editor. *@
                <TemplateColumn Title="@L["Page.Pipelines.Source"]">
                    <span title="@context.SourceId" data-testid="@($"source-{context.Id}")">@ConnectionName(context.SourceId)</span>
                </TemplateColumn>
                <TemplateColumn Title="@L["Page.Pipelines.Destination"]">
                    <span title="@context.DestinationId" data-testid="@($"dest-{context.Id}")">@ConnectionName(context.DestinationId)</span>
                </TemplateColumn>
                <TemplateColumn Title="@L["Page.Pipelines.Scheduler"]">
                    @* En una línea (antes la insignia quedaba encima del botón): la columna toma el
                       ancho que necesita. *@
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Wrap="false" Class="cell-inline">
                        <FluentBadge data-testid="@($"sched-{context.Id}-{(context.Enabled ? "on" : "off")}")" Appearance="@(context.Enabled ? BadgeAppearance.Filled : BadgeAppearance.Tint)" Color="@(context.Enabled ? BadgeColor.Brand : BadgeColor.Informative)">
                            @(context.Enabled ? L["Page.Pipelines.SchedulerActive"] : L["Page.Pipelines.SchedulerInactive"])
                        </FluentBadge>
                        <FluentButton Appearance="ButtonAppearance.Subtle" data-testid="@($"toggle-{context.Id}")" OnClick="@(() => Toggle(context))">
                            @(context.Enabled ? L["Page.Pipelines.SchedulerOff"] : L["Page.Pipelines.SchedulerOn"])
                        </FluentButton>
                        <QueuedRunBadge PipelineId="@context.Id" Queued="@RunQueue.Get(context.Id)" OnChanged="@OnRunCompleted" />
                    </FluentStack>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Actions"]">
                    <FluentMenu>
                        <FluentMenuButton Appearance="ButtonAppearance.Outline" data-testid="@($"actions-{context.Id}")" Label="@L["Common.Actions"]" />
                        <FluentMenuList>
                            <PipelineRunActions PipelineId="@context.Id" OnCompleted="@OnRunCompleted" />
                            <FluentMenuItem data-testid="@($"edit-{context.Id}")" OnClick="@(() => Edit(context))">@L["Common.Edit"]</FluentMenuItem>
                            <FluentMenuItem data-testid="@($"catalog-{context.Id}")" OnClick="@(() => Nav.NavigateTo($"/catalog?pipeline={Uri.EscapeDataString(context.Id)}"))">@L["Page.Pipelines.TablesAndColumns"]</FluentMenuItem>
                            <FluentMenuItem data-testid="@($"reset-{context.Id}")" OnClick="@(() => ConfirmReset(context))">@L["Page.Pipelines.Reset"]</FluentMenuItem>
                            <FluentMenuItem data-testid="@($"delete-{context.Id}")" OnClick="@(() => ConfirmDelete(context))">@L["Common.Delete"]</FluentMenuItem>
                        </FluentMenuList>
                    </FluentMenu>
                </TemplateColumn>
            </FluentDataGrid>
        </ListContent>
    </ListWithEmptyCta>

    <PaginationControl Page="_page" TotalPages="_totalPages" TotalCount="_totalCount" PageChanged="OnPageChanged" />
    </PageSection>
</FluentStack>

<InlineDialog @bind-Visible="_showEditor" Title="@_editorTitle" Class="dialog-wide">
    <ChildContent>
    @* Con FluentOption escritas a mano, el desplegable no reflejaba el Value asignado por código
       al reutilizar el diálogo: mostraba vacío o la última opción pulsada en otro pipeline, y
       guardar podía reasignar este pipeline al origen/destino de aquel. Con Items el componente
       marca la opción a partir del Value, y el @key por apertura descarta cualquier estado previo. *@
    <div class="dialog-form" @key="_editorKey">
        <FluentTextInput @bind-Value="_editName" data-testid="pipe-name" Label="@L["Common.Name"]" />
        <FluentSelect TOption="Connection" TValue="string" @bind-Value="_sourceId" data-testid="pipe-source" Label="@L["Page.Pipelines.Source"]"
                      Items="@Connections.List(ConnectionRole.Source)" OptionValue="@(c => c.Id)" OptionText="@(c => c.Name)" />
        <FluentSelect TOption="Connection" TValue="string" @bind-Value="_destId" data-testid="pipe-dest" Label="@L["Page.Pipelines.Destination"]"
                      Items="@Connections.List(ConnectionRole.Destination)" OptionValue="@(c => c.Id)" OptionText="@(c => c.Name)" />
        <FluentSelect TOption="DeleteMode" TValue="string" @bind-Value="_deleteMode" data-testid="pipe-delete-mode" Label="@L["Page.Pipelines.DeleteMode"]"
                      Items="@(Enum.GetValues<DeleteMode>())" OptionValue="@(m => m.ToString())" OptionText="@(m => L[$"Page.Pipelines.DeleteMode.{m}"].Value)" />
        <p class="field-hint">@L["Page.Pipelines.DeleteModeHint"]</p>
    </div>
    </ChildContent>
    <Actions>
        <FluentButton data-testid="pipe-cancel" OnClick="() => _showEditor = false">@L["Common.Cancel"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="pipe-save" OnClick="SaveEditor">@L["Common.Save"]</FluentButton>
    </Actions>
</InlineDialog>

<InlineDialog @bind-Visible="_showDelete" Title="@L["Page.Pipelines.DeleteTitle"]">
    <ChildContent>
    @* fluent-label es flex: texto y <strong> serían ítems separados y el espacio entre ambos se
       pierde. Un único <span> los mantiene en la misma línea de texto. *@
    <FluentLabel><span>@L["Page.Pipelines.DeletePrefix"] <strong>@_deleteName</strong>?</span></FluentLabel>
    <FluentCheckbox @bind-Value="_wipeState" Label="@L["Page.Pipelines.WipeState"]" />
    </ChildContent>
    <Actions>
        <FluentButton OnClick="() => _showDelete = false">@L["Common.Cancel"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="pipe-delete-confirm" OnClick="DeleteConfirmed">@L["Common.Delete"]</FluentButton>
    </Actions>
</InlineDialog>

<InlineDialog @bind-Visible="_showReset" Title="@L["Page.Pipelines.ResetTitle"]">
    <ChildContent>
    @* Ver el diálogo de borrado: un único <span> para no perder el espacio dentro de fluent-label. *@
    <FluentLabel><span>@L["Page.Pipelines.ResetPrefix"] <strong>@_resetName</strong>?</span></FluentLabel>
    <FluentLabel Class="field-hint">@L["Page.Pipelines.ResetWarning"]</FluentLabel>
    <FluentLabel Class="field-hint">@L["Page.Pipelines.ResetKeeps"]</FluentLabel>
    <FluentCheckbox @bind-Value="_truncateSql" Label="@L["Page.Pipelines.ResetTruncateSql"]" />
    <FluentLabel Class="field-hint">@L["Page.Pipelines.ResetTruncateSqlHint"]</FluentLabel>
    </ChildContent>
    <Actions>
        <FluentButton OnClick="() => _showReset = false">@L["Common.Cancel"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="pipe-reset-confirm" Disabled="@_resetting" Loading="@_resetting" OnClick="ResetConfirmed">@L["Page.Pipelines.Reset"]</FluentButton>
    </Actions>
</InlineDialog>

@code {
    private List<Pipeline> _allItems = [];
    private List<Pipeline> _items = [];
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private int _totalPages = 1;
    private bool _showEditor;
    private bool _showDelete;
    private string _editorTitle = "";
    private string? _editingId;
    private string? _createdPipelineId;
    private string _editName = "";
    private string _sourceId = "";
    private string _destId = "";
    private string _deleteMode = nameof(DeleteMode.Delete);
    private Guid _editorKey = Guid.NewGuid();
    private string? _deleteId;
    private string? _deleteName;
    private bool _wipeState;
    private bool _showReset;
    private bool _resetting;
    private string? _resetId;
    private string? _resetName;
    private bool _truncateSql;
    private ReconcileReport? _latestReconcile;
    private Dictionary<string, string> _connectionNames = [];
    private PageRefreshTimer? _queueTimer;
    private bool _watchingQueue;

    protected override void OnInitialized() => Load();

    private Task OnRunCompleted()
    {
        Load();
        return Task.CompletedTask;
    }

    private void Load()
    {
        _allItems = PipelineService.List().OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList();
        _connectionNames = Connections.List().ToDictionary(c => c.Id, c => c.Name);
        // Sobre TODOS los pipelines, no solo la página actual: es un resumen global.
        _latestReconcile = _allItems
            .Select(p => Reports.GetLatestReconcile(p.Id))
            .Where(r => r is not null)
            .OrderByDescending(r => r!.CreatedAt)
            .FirstOrDefault();
        ApplyPaging();
        WatchQueue();
    }

    // Una conexión borrada ya no tiene nombre: se muestra su id.
    private string ConnectionName(string id) => _connectionNames.GetValueOrDefault(id) ?? id;

    private bool HasQueued() => _allItems.Any(p => RunQueue.Get(p.Id) is not null);

    // Lo encolado lo lanza el scheduler sin pasar por esta página: mientras haya algo en cola se
    // repinta para que la etiqueta desaparezca sola al arrancar. El repintado que ya no ve nada en
    // cola es el último (así se quita la etiqueta) y el timer se detiene hasta que se encole otra.
    private void WatchQueue()
    {
        if (!RendererInfo.IsInteractive || _watchingQueue || !HasQueued())
        {
            return;
        }

        _watchingQueue = true;
        _queueTimer ??= new PageRefreshTimer(
            TimeSpan.FromSeconds(10),
            _ => InvokeAsync(() =>
            {
                _watchingQueue = HasQueued();
                StateHasChanged();
            }),
            () => _watchingQueue,
            onError: ex => Logger.LogWarning(ex, "Refresco de la cola en Pipelines falló; se reintenta."));
        _queueTimer.Start();
    }

    public async ValueTask DisposeAsync()
    {
        if (_queueTimer is not null)
        {
            await _queueTimer.DisposeAsync();
        }
    }

    // La lista ya se carga entera en memoria (PipelineStore.ListAll); paginar aquí es
    // solo de presentación, sin tocar IPipelineService (mismo patrón que Tables.razor).
    private void ApplyPaging()
    {
        _totalCount = _allItems.Count;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
        if (_page > _totalPages)
        {
            _page = _totalPages;
        }

        _items = _allItems.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void OnPageChanged(int page)
    {
        _page = page;
        ApplyPaging();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _editorTitle = L["Page.Pipelines.NewTitle"].Value;
        _editName = "";
        _sourceId = Connections.List(ConnectionRole.Source).FirstOrDefault()?.Id ?? "";
        _destId = Connections.List(ConnectionRole.Destination).FirstOrDefault()?.Id ?? "";
        _deleteMode = nameof(DeleteMode.Delete);
        _editorKey = Guid.NewGuid();
        _showEditor = true;
    }

    private void Edit(Pipeline pipeline)
    {
        _editingId = pipeline.Id;
        _editorTitle = L["Page.Pipelines.EditTitle"].Value;
        _editName = pipeline.Name;
        _sourceId = pipeline.SourceId;
        _destId = pipeline.DestinationId;
        _deleteMode = pipeline.DeleteMode.ToString();
        _editorKey = Guid.NewGuid();
        _showEditor = true;
    }

    private void SaveEditor()
    {
        try
        {
            if (_editingId is null)
            {
                var slug = Sluice.Portal.Services.Stores.EntityIds.Slugify(_editName);
                if (slug.Length == 0)
                {
                    _ = NotificationService.ShowErrorToastAsync(L["Common.NameRequired"].Value);
                    return;
                }

                PipelineService.Create(Audit.Current, new Pipeline
                {
                    Id = $"pipe-{slug}",
                    Name = _editName,
                    SourceId = _sourceId,
                    DestinationId = _destId,
                    DeleteMode = Enum.Parse<DeleteMode>(_deleteMode),
                    Enabled = false, // scheduler apagado al crear: primero se corre a mano, luego se activa
                });
                _createdPipelineId = $"pipe-{slug}";
            }
            else
            {
                var existing = PipelineService.Get(_editingId)!;
                PipelineService.Update(Audit.Current, _editingId, existing with
                {
                    Name = _editName,
                    SourceId = _sourceId,
                    DestinationId = _destId,
                    DeleteMode = Enum.Parse<DeleteMode>(_deleteMode),
                });
            }

            _showEditor = false;
            _ = NotificationService.ShowSuccessToastAsync(L["Common.Saved"].Value);
            Load();
        }
        catch (Exception ex)
        {
            _ = NotificationService.ShowErrorToastAsync(ErrorText.Render(L, ex));
        }
    }

    private void Toggle(Pipeline pipeline)
    {
        var next = !pipeline.Enabled;
        PipelineService.SetScheduler(Audit.Current, pipeline.Id, next);
        _ = NotificationService.ShowInfoToastAsync(next ? L["Page.Pipelines.SchedulerActive"].Value : L["Page.Pipelines.SchedulerInactive"].Value);
        Load();
    }

    private void ConfirmDelete(Pipeline pipeline)
    {
        _deleteId = pipeline.Id;
        _deleteName = pipeline.Name;
        _wipeState = false;
        _showDelete = true;
    }

    private async Task DeleteConfirmed()
    {
        if (_deleteId is null)
        {
            return;
        }

        try
        {
            if (await PipelineService.DeleteAsync(Audit.Current, _deleteId, _wipeState) is { } error)
            {
                _ = NotificationService.ShowErrorToastAsync(error);
                return;
            }
        }
        catch (PipelineBusyException ex)
        {
            _ = NotificationService.ShowErrorToastAsync(ErrorText.Render(L, ex));
            return;
        }

        _ = NotificationService.ShowInfoToastAsync(string.Format(L["Common.Deleted"].Value, _deleteName ?? _deleteId));
        _showDelete = false;
        Load();
    }

    private void ConfirmReset(Pipeline pipeline)
    {
        _resetId = pipeline.Id;
        _resetName = pipeline.Name;
        _truncateSql = false;
        _showReset = true;
    }

    private async Task ResetConfirmed()
    {
        // El reset es largo (trunca SQL, borra parquets): un segundo clic lanzaría otro en paralelo.
        if (_resetId is null || _resetting)
        {
            return;
        }

        _resetting = true;
        try
        {
            var result = await PipelineResetService.ResetAsync(Audit.Current, _resetId, _truncateSql);
            if (!result.Completed)
            {
                await NotificationService.ShowErrorToastAsync(string.Format(L["Page.Pipelines.ResetFailed"].Value, result.TableTruncateFailures.Count));
                return;
            }

            await NotificationService.ShowInfoToastAsync(string.Format(L["Page.Pipelines.ResetSuccess"].Value, result.TablesTruncated.Count, result.ParquetArtifactsDeleted));
            _showReset = false;
            Load();
        }
        catch (Exception ex)
        {
            await NotificationService.ShowErrorToastAsync(ErrorText.Render(L, ex));
        }
        finally
        {
            _resetting = false;
        }
    }
}