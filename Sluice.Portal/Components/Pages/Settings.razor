@page "/settings"
@rendermode InteractiveServer
@using Sluice.Portal.Components.Shared
@using Sluice.Portal.Models
@using Sluice.Portal.Services
@using Sluice.Portal.Services.Stores
@inject SettingsStore SettingsStore
@inject SettingsService SettingsService
@inject Sluice.Portal.Services.Logging.CircuitAuditActor Audit
@inject AlertService AlertService
@inject AlertDeliveryStatusStore DeliveryStatusStore
@inject DeadmanService Deadman
@inject IStringLocalizer<SharedResource> L
@inject BrowserTime Time

<PageTitle>@L["Nav.Settings"]</PageTitle>

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="12">
    <PageHeader Title="@L["Page.Settings.Title"]" Subtitle="@L["Page.Settings.Subtitle"]" />

    @if (_unreadable)
    {
        <FluentMessageBar data-testid="settings-unreadable" Intent="MessageBarIntent.Warning">@L["Page.Settings.Unreadable"]</FluentMessageBar>
    }

    <PageSection Title="@L["Page.Settings.Scheduler.Title"]">
        <div class="dialog-form dialog-form--narrow">
            <FluentNumberInput TValue="int" @bind-Value="_pollMinutes" Label="@L["Page.Settings.PollMinutes"]" />
            <FluentNumberInput TValue="int" @bind-Value="_leaseSeconds" Label="@L["Page.Settings.LeaseSeconds"]" />
            <FluentNumberInput TValue="double" @bind-Value="_divergencePct" Label="@L["Page.Settings.DivergencePct"]" />
            <FluentSwitch @bind-Value="_autoRemediate" Label="@L["Page.Settings.AutoRemediate"]" data-testid="settings-autofix" />
            <p class="field-hint">@L["Page.Settings.AutoRemediate.Hint"]</p>
        </div>
    </PageSection>

    <PageSection Title="@L["Page.Settings.Retention.Title"]">
        <div class="dialog-form dialog-form--narrow">
            <FluentNumberInput TValue="int" @bind-Value="_retentionDays" Label="@L["Page.Settings.RetentionDays"]" />
            <p class="field-hint">@L["Page.Settings.RetentionDays.Hint"]</p>
            <FluentNumberInput TValue="int" @bind-Value="_staleTableDays" Label="@L["Page.Settings.StaleTableDays"]" data-testid="settings-stale-days" />
            <p class="field-hint">@L["Page.Settings.StaleTableDays.Hint"]</p>
            <FluentNumberInput TValue="int" @bind-Value="_parquetVersionDays" Label="@L["Page.Settings.ParquetVersionDays"]" data-testid="settings-parquet-version-days" />
            <p class="field-hint">@L["Page.Settings.ParquetVersionDays.Hint"]</p>
            <FluentNumberInput TValue="int" @bind-Value="_sourceSnapshotRetentionDays" Label="@L["Page.Settings.SourceSnapshotRetentionDays"]" />
            <p class="field-hint">@L["Page.Settings.SourceSnapshotRetentionDays.Hint"]</p>
            <FluentSwitch @bind-Value="_sourceSnapshotRetentionDryRun" Label="@L["Page.Settings.SourceSnapshotRetentionDryRun"]" />
            <p class="field-hint">@L["Page.Settings.SourceSnapshotRetentionDryRun.Hint"]</p>
            <FluentSwitch @bind-Value="_sourceSnapshotRetentionRequireParquet" Label="@L["Page.Settings.SourceSnapshotRetentionRequireParquet"]" />
            <p class="field-hint">@L["Page.Settings.SourceSnapshotRetentionRequireParquet.Hint"]</p>
        </div>
    </PageSection>

    <PageSection Title="@L["Page.Settings.Alerts.Title"]">
        <div class="dialog-form dialog-form--narrow">
            <p class="field-hint">@L["Page.Settings.Alerts.Hint"]</p>
            <FluentSwitch @bind-Value="_alertEnabled" Label="@L["Page.Settings.Alerts.Enabled"]" />
            <FluentNumberInput TValue="int" @bind-Value="_pipelineLagAlertHours" Label="@L["Page.Settings.PipelineLagAlertHours"]" data-testid="settings-pipeline-lag-hours" />
            <p class="field-hint">@L["Page.Settings.PipelineLagAlertHours.Hint"]</p>
            @* La URL lleva la firma (sig=...): no se envía al navegador. Vacío = conservar la guardada. *@
            <FluentTextInput @bind-Value="_alertWebhookUrl" Label="@L["Page.Settings.Alerts.WebhookUrl"]"
                             TextInputType="TextInputType.Password"
                             Placeholder="@(string.IsNullOrWhiteSpace(_storedWebhookUrl) ? "https://..." : L["Page.Settings.Alerts.WebhookStored"].Value)" />
            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="settings-test-alert" OnClick="TestAlertAsync" Disabled="_testingAlert">
                @(_testingAlert ? L["Page.Settings.Alerts.Testing"] : L["Page.Settings.Alerts.Test"])
            </FluentButton>

            @if (_testResult is not null)
            {
                <FluentMessageBar data-testid="settings-alert-test-result" Intent="@(_testResult.Success ? MessageBarIntent.Success : MessageBarIntent.Error)">
                    @_testResult.Detail
                </FluentMessageBar>
            }

            @* Última entrega real (no las pruebas), la registre la api o un worker. *@
            <div data-testid="settings-alert-delivery">
                <h3 class="dialog-form-subtitle">@L["Page.Settings.Alerts.LastDelivery"]</h3>
                @if (_delivery is null)
                {
                    <p class="field-hint">@L["Page.Settings.Alerts.LastDelivery.None"]</p>
                }
                else if (_delivery.LastSucceeded)
                {
                    <p class="field-hint">@L["Page.Settings.Alerts.LastDelivery.Ok", FormatTime(_delivery.LastAttemptAt), _delivery.LastEventType ?? "", _delivery.LastDetail ?? ""]</p>
                }
                else
                {
                    <FluentMessageBar Intent="MessageBarIntent.Warning">
                        @L["Page.Settings.Alerts.LastDelivery.Failed", FormatTime(_delivery.LastAttemptAt), _delivery.LastEventType ?? "", _delivery.LastDetail ?? ""]
                        @(_delivery.LastSuccessAt is { } ok
                            ? L["Page.Settings.Alerts.LastDelivery.LastSuccess", FormatTime(ok)]
                            : L["Page.Settings.Alerts.LastDelivery.NeverSucceeded"])
                    </FluentMessageBar>
                }
            </div>

            @* Ping al monitor externo al final de cada poll sano del scheduler (DEADMAN_PING_URL). *@
            <div data-testid="settings-deadman">
                <h3 class="dialog-form-subtitle">@L["Page.Settings.Deadman"]</h3>
                @if (!Deadman.IsConfigured)
                {
                    <p class="field-hint">@L["Page.Settings.Deadman.NotConfigured"]</p>
                }
                else if (Deadman.LastPing is not { } ping)
                {
                    <p class="field-hint">@L["Page.Settings.Deadman.Waiting"]</p>
                }
                else if (ping.Success)
                {
                    <p class="field-hint">@L["Page.Settings.Deadman.Ok", FormatTime(ping.At), ping.Detail]</p>
                }
                else
                {
                    <FluentMessageBar Intent="MessageBarIntent.Warning">@L["Page.Settings.Deadman.Failed", FormatTime(ping.At), ping.Detail]</FluentMessageBar>
                }
            </div>
        </div>
    </PageSection>

    <PageSection Title="@L["Page.Settings.LogicApp.Title"]">
        @* Paquete descargable de la Logic App que convierte el webhook de alertas en correos. Descarga
           por HTTP con ForceLoad: sin él el router de Blazor trata /api/... como página ("Not found"). *@
        <div class="la-card" data-testid="logicapp-card">
            <div class="la-card__hero">
                <img src="logo.svg" width="48" height="48" alt="" />
                <div>
                    <p class="la-card__eyebrow">Azure Logic App · Office 365 Outlook</p>
                    <h3>@L["Page.Settings.LogicApp.Headline"]</h3>
                    <p>@L["Page.Settings.LogicApp.Pitch"]</p>
                </div>
            </div>
            <div class="la-card__body">
                <ol class="la-card__steps">
                    @for (var i = 1; i <= 4; i++)
                    {
                        <li><span class="la-card__num">@i</span><span>@L[$"Page.Settings.LogicApp.Step{i}"]</span></li>
                    }
                </ol>
                <div class="la-card__events">
                    <span class="la-card__label">@L["Page.Settings.LogicApp.Events"]</span>
                    <span class="la-chip"><i class="la-chip__dot la-chip__dot--failure"></i>@L["Page.Settings.LogicApp.Event.Failure"]</span>
                    <span class="la-chip"><i class="la-chip__dot la-chip__dot--divergence"></i>@L["Page.Settings.LogicApp.Event.Divergence"]</span>
                    <span class="la-chip"><i class="la-chip__dot la-chip__dot--values"></i>@L["Page.Settings.LogicApp.Event.Values"]</span>
                    <span class="la-chip"><i class="la-chip__dot la-chip__dot--test"></i>@L["Page.Settings.LogicApp.Event.Test"]</span>
                </div>
                <div class="la-card__actions">
                    <FluentAnchorButton Href="/api/settings/logic-app-package" ForceLoad="true" Appearance="ButtonAppearance.Outline"
                                        IconStart="@(new Icons.Regular.Size20.ArrowDownload())" data-testid="logicapp-download">@L["Page.Settings.LogicApp.Download"]</FluentAnchorButton>
                    <span class="la-card__meta">@L["Page.Settings.LogicApp.Contents"]</span>
                </div>
            </div>
        </div>
    </PageSection>

    <div class="dialog-form dialog-form--narrow">
        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="settings-save" OnClick="SaveSettings">@L["Common.Save"]</FluentButton>

        @if (!string.IsNullOrWhiteSpace(_saveError))
        {
            <FluentMessageBar data-testid="settings-save-error" Intent="MessageBarIntent.Error">@_saveError</FluentMessageBar>
        }

        @if (_confirmOverwrite)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning">@L["Page.Settings.Unreadable.ConfirmPrompt"]</FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="settings-overwrite-confirm" OnClick="ConfirmOverwrite">@L["Page.Settings.Unreadable.Confirm"]</FluentButton>
        }

        @if (_saved)
        {
            <FluentMessageBar data-testid="settings-saved" Intent="MessageBarIntent.Success">@L["Page.Settings.Saved"]</FluentMessageBar>
        }
    </div>
</FluentStack>

@code {
    private int _pollMinutes = 5;
    private int _leaseSeconds = 120;
    private double _divergencePct = 1.0;
    private bool _autoRemediate;
    private int _retentionDays = 90;
    private int _sourceSnapshotRetentionDays = 30;
    private int _staleTableDays = 7;
    private int _parquetVersionDays = 7;
    private bool _sourceSnapshotRetentionDryRun;
    private bool _sourceSnapshotRetentionRequireParquet = true;
    private bool _alertEnabled;
    private int _pipelineLagAlertHours = 6;
    private string? _alertWebhookUrl;
    private string? _storedWebhookUrl;

    private string? EffectiveWebhookUrl =>
        string.IsNullOrWhiteSpace(_alertWebhookUrl) ? _storedWebhookUrl : _alertWebhookUrl.Trim();
    private bool _saved;
    private string? _saveError;
    // settings.json existe y no se puede leer: la página muestra los valores por defecto, y guardar
    // sobrescribiría lo que tenía (el webhook, por ejemplo). Solo se guarda tras confirmarlo.
    private bool _unreadable;
    private bool _confirmOverwrite;
    private bool _overwriteConfirmed;
    private bool _testingAlert;
    private AlertDeliveryResult? _testResult;
    private AlertDeliveryStatus? _delivery;

    private string FormatTime(DateTimeOffset at) => Time.Format(at, "G");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await Time.InitAsync())
        {
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        _delivery = DeliveryStatusStore.Get();
        _unreadable = !SettingsStore.TryGet(out var settings);
        _pollMinutes = settings.SchedulerPollMinutes;
        _leaseSeconds = settings.TaskLeaseSeconds;
        _divergencePct = settings.ReconDivergencePct;
        _autoRemediate = settings.AutoRemediate;
        _retentionDays = settings.RetentionDays;
        _staleTableDays = settings.StaleTableDays;
        _parquetVersionDays = settings.ParquetVersionDays;
        _sourceSnapshotRetentionDays = settings.SourceSnapshotRetentionDays;
        _sourceSnapshotRetentionDryRun = settings.SourceSnapshotRetentionDryRun;
        _sourceSnapshotRetentionRequireParquet = settings.SourceSnapshotRetentionRequireParquet;
        _alertEnabled = settings.AlertEnabled;
        _pipelineLagAlertHours = settings.PipelineLagAlertHours;
        _storedWebhookUrl = settings.AlertWebhookUrl;
    }

    private void SaveSettings()
    {
        _saveError = null;
        _saved = false;

        if (_alertEnabled && string.IsNullOrWhiteSpace(EffectiveWebhookUrl))
        {
            _saveError = L["Page.Settings.Alerts.UrlRequired"].Value;
            return;
        }

        var settings = new AppSettings
        {
            SchedulerPollMinutes = _pollMinutes,
            TaskLeaseSeconds = _leaseSeconds,
            ReconDivergencePct = _divergencePct,
            AutoRemediate = _autoRemediate,
            RetentionDays = _retentionDays,
            StaleTableDays = _staleTableDays,
            ParquetVersionDays = _parquetVersionDays,
            SourceSnapshotRetentionDays = _sourceSnapshotRetentionDays,
            SourceSnapshotRetentionDryRun = _sourceSnapshotRetentionDryRun,
            SourceSnapshotRetentionRequireParquet = _sourceSnapshotRetentionRequireParquet,
            AlertEnabled = _alertEnabled,
            PipelineLagAlertHours = _pipelineLagAlertHours,
            AlertWebhookUrl = EffectiveWebhookUrl,
        };

        if (SettingsStore.Validate(settings) is { } invalidKey)
        {
            _saveError = L[invalidKey].Value;
            return;
        }

        if (_unreadable && !_overwriteConfirmed)
        {
            _confirmOverwrite = true;
            return;
        }

        SettingsService.Save(Audit.Current, settings);
        _storedWebhookUrl = settings.AlertWebhookUrl;
        _alertWebhookUrl = null;
        _saved = true;
        _testResult = null;
        _unreadable = false;
        _confirmOverwrite = false;
    }

    private void ConfirmOverwrite()
    {
        _overwriteConfirmed = true;
        SaveSettings();
    }

    private async Task TestAlertAsync()
    {
        _testingAlert = true;
        _testResult = null;
        try
        {
            _testResult = await AlertService.SendTestAlertAsync(EffectiveWebhookUrl);
        }
        finally
        {
            _testingAlert = false;
        }
    }
}