<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sluice.Portal.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Files.DataLake" Version="12.28.0" />
    <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- Transitiva de Microsoft.Data.SqlClient 7.1.1 (trae la 9.0.18): se fija la versión
         corregida de GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7 hasta que SqlClient la suba. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Guía de usuario (Markdown): fuente única en docs/guia-usuario, empaquetada
       junto a la app para servirla desde la página /ayuda del portal. -->
  <ItemGroup>
    <Content Include="..\docs\guia-usuario\*.md" Link="guia-usuario\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Paquete de la Logic App de alertas: viaja con la app y Ajustes lo ofrece como .zip
       (GET /api/settings/logic-app-package). Fuera del Content por defecto de la web: no es web. -->
  <ItemGroup>
    <Content Remove="Deploy\**" />
    <None Remove="Deploy\**" />
    <Content Include="Deploy\LogicApp\*" Link="logic-app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
